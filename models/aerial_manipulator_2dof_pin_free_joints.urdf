      <geometry>
        <cylinder radius=".06477" length="0.007"/>
      </geometry>
      <material name="wash" />
    </visual>
  </link>
  <link name="prop2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius=".06477" length="0.007"/>
      </geometry>
      <material name="wash" />
