  </link>
  <link name="link1">
    <inertial>
      <mass value=".053412"/>
      <inertia ixx="0.000021" ixy="0.000000" ixz="0.000000" iyy="0.000021" iyz="0.000001" izz="0.000005"/>
      <origin rpy=" 0 0 0" xyz="0 0 0.1607"/>
    </inertial>
    <visual>
      <origin rpy=" 0 0 0" xyz="0 0 0.1607"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="green">
            <color rgba="0 1 0 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 -.0095 0.0205" rpy="0 0 0" />
      <geometry>
        <box size=".009 .004 .041" />
      </geometry>
      <material name="carbon">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <!-- Wrist Motor -->
    <visual>
      <origin xyz="0 0 0.052" rpy="0 0 0" />
      <geometry>
        <cylinder radius=".0142" length="0.022"/>
      </geometry>
      <material name="motor" />
    </visual>
    <!-- Carbon Fiber Tube -->
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0" />
      <geometry>
        <cylinder radius=".0075" length="0.115"/>
      </geometry>
      <material name="carbon" />
    </visual>
  </link>
  <joint name="joint1" type="continuous">
    <parent link="vehicle"/>
    <child link="link1"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
    <!-- <origin rpy="0 1.57079632679 0" xyz="0 0 -.1607"/> -->
    <origin rpy="0 1.57079632679 0" xyz="0 0 0"/>
    <limit velocity="1e9" effort=".9" lower="-3.1415926" upper="3.1415926" />
  </joint>
  <link name="link2">
    <inertial>
      <mass value="0.07583633"/>
      <inertia ixx="0.00010771" ixy="0.00000000" ixz="0.00000000" iyy=" 0.00011016" iyz="0.00000000" izz="0.00000767"/>
      <origin rpy=" 0 0 0" xyz="0 0 -0.12635585 "/>
      <!-- ignored offsets in other directions -->
    </inertial>
    <!-- <visual>
      <origin rpy=" 0 0 0" xyz="0 0 -0.12635585"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="blue">
            <color rgba="0 0 1 1"/>
      </material>
    </visual> -->
    <!-- Gripper Palm -->
    <visual>
      <origin xyz="0 0 -.0207" rpy="0 0 0" />
      <geometry>
        <box size=".04 .022 .01" />
      </geometry>
      <material name="carbon">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <!-- Servo -->
    <visual>
      <origin xyz="0 0 -0.0357" rpy="0 0 0" />
      <geometry>
        <box size=".03 .015 .02" />
      </geometry>
      <material name="tmotor">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
    <!-- Finger -->
    <visual>
      <origin xyz=".018 0 -.0007" rpy="0 0 0" />
      <geometry>
        <box size=".004 .022 .03" />
      </geometry>
      <material name="tip">
        <color rgba="0.7 0.3 0.3 1.0"/>
      </material>
    </visual>
    <!-- Finger -->
    <visual>
      <origin xyz="-.018 0 -.0007" rpy="0 0 0" />
      <geometry>
        <box size=".004 .022 .03" />
      </geometry>
      <material name="tip">
        <color rgba="0.7 0.3 0.3 1.0"/>
      </material>
    </visual>
  </link>
  <!-- Physical Joints -->
  <!--  -->
  <joint name="joint2" type="continuous">
    <parent link="link1"/>
    <child link="link2"/>
    <origin rpy="0 0 1.57079632679" xyz=" 0 0 0.2232"/>
    <axis rpy="0 0 0" xyz="0 0 1"/>
    <limit velocity="1e9" effort=".1" lower="-3.1415926" upper="3.1415926" />
  </joint>
  

  <material name="wash">
    <color rgba="1 0 0 .15"/>
  </material>
  <material name="prop">
    <color rgba="1 0 0 1"/>
  </material>

  <!-- Motors -->
  <material name="motor">
    <color rgba="0.5 0.5 .5 1.0"/>
  </material>

  <link name="motor1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius=".0142" length="0.022"/>
      </geometry>
      <material name="motor" />
    </visual>
  </link>
  <link name="motor2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius=".0142" length="0.022"/>
